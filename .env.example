# CLONE: every variable is optional. Set them in your host's dashboard
# (Vercel → Settings → Environment Variables); never commit real values.

# Canonical URL for social cards and metadata.
NEXT_PUBLIC_SITE_URL=

# Claude-written clone speech (Haiku). Unset → deterministic rule bank.
ANTHROPIC_API_KEY=

# --- persistence -------------------------------------------------------------
# Both set → Supabase (durable on Vercel). Run supabase/schema.sql first.
# SERVER-ONLY: never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# File backend location when Supabase is not configured (local dev / a VPS disk).
CLONE_DATA_DIR=

# --- $CLONE seats (residents) -------------------------------------------------
# Seats stay "not open" until the first five are set. See docs/TOKEN.md.
CLONE_TOKEN_MINT=
CLONE_TOKEN_CREATOR=
CLONE_X_HANDLE=
CLONE_SEAT_CAP=
CLONE_SEAT_MIN_HOLD=
CLONE_TOKEN_SYMBOL=CLONE
CLONE_TOKEN_NAME=CLONE
# RPC for "sell it, lose it" balance checks. Unset → Solana's public RPC (rate limited).
SOLANA_RPC_URL=
